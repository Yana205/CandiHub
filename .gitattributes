# CandiHub — cross-platform Git rules (macOS <-> Windows)
#
# The single most important line is the default below. Without it, a file
# saved on Windows (CRLF endings) and a file saved on macOS (LF endings)
# look 100% different to Git, so every diff is unreadable and every merge
# conflicts on every line.

# ------------------------------------------------------------------
# Default: detect text files, store them with LF in the repository,
# and check them out with each platform's native endings.
# ------------------------------------------------------------------
* text=auto

# ------------------------------------------------------------------
# Unity YAML. Unity always writes LF, on every platform. Pin these to LF
# in the working tree too, so the editor never rewrites a whole file just
# because it was checked out on Windows.
#
# merge=unityyamlmerge routes conflicts through Unity's semantic YAML
# merge tool instead of Git's line-based merge, which mangles scenes and
# prefabs. Each developer enables it once per machine — see README.
# ------------------------------------------------------------------
*.unity          text eol=lf merge=unityyamlmerge diff
*.prefab         text eol=lf merge=unityyamlmerge diff
*.asset          text eol=lf merge=unityyamlmerge diff
*.meta           text eol=lf merge=unityyamlmerge diff
*.mat            text eol=lf merge=unityyamlmerge diff
*.anim           text eol=lf merge=unityyamlmerge diff
*.controller     text eol=lf merge=unityyamlmerge diff
*.overrideController text eol=lf merge=unityyamlmerge diff
*.physicMaterial text eol=lf merge=unityyamlmerge diff
*.physicsMaterial2D text eol=lf merge=unityyamlmerge diff
*.playable       text eol=lf merge=unityyamlmerge diff
*.mask           text eol=lf merge=unityyamlmerge diff
*.brush          text eol=lf merge=unityyamlmerge diff
*.flare          text eol=lf merge=unityyamlmerge diff
*.fontsettings   text eol=lf merge=unityyamlmerge diff
*.guiskin        text eol=lf merge=unityyamlmerge diff
*.giparams       text eol=lf merge=unityyamlmerge diff
*.renderTexture  text eol=lf merge=unityyamlmerge diff
*.spriteatlas    text eol=lf merge=unityyamlmerge diff
*.terrainlayer   text eol=lf merge=unityyamlmerge diff
*.mixer          text eol=lf merge=unityyamlmerge diff
*.shadervariants text eol=lf merge=unityyamlmerge diff
*.preset         text eol=lf merge=unityyamlmerge diff
*.scenetemplate  text eol=lf merge=unityyamlmerge diff

# ------------------------------------------------------------------
# Source and config: LF everywhere. Visual Studio, Rider and VS Code all
# handle LF correctly on Windows.
# ------------------------------------------------------------------
*.cs             text eol=lf diff=csharp
*.shader         text eol=lf
*.shadergraph    text eol=lf
*.compute        text eol=lf
*.cginc          text eol=lf
*.hlsl           text eol=lf
*.uss            text eol=lf
*.uxml           text eol=lf
*.json           text eol=lf
*.inputactions   text eol=lf
*.asmdef         text eol=lf
*.asmref         text eol=lf
*.xml            text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.md             text eol=lf
*.txt            text eol=lf
*.sh             text eol=lf

# Windows batch files break if they are checked out with LF endings.
*.bat            text eol=crlf
*.cmd            text eol=crlf
*.ps1            text eol=crlf

# ------------------------------------------------------------------
# Git LFS — binary assets.
#
# Git stores a full copy of every version of every file forever. A 20 MB
# texture edited ten times is 200 MB in the repo, permanently, for everyone
# who clones. LFS instead commits a ~130-byte pointer and keeps the real
# bytes on GitHub's LFS server, fetched only for the commit you check out.
#
# "filter=lfs" routes content through LFS on add/checkout.
# "diff=lfs merge=lfs" stops Git trying to diff or merge binary content.
# "-text" disables line-ending conversion — a "normalized" PNG is a
# corrupted PNG.
#
# EVERY machine that clones this repo must have git-lfs installed BEFORE
# cloning, or these files arrive as unusable pointer text. See README.
# ------------------------------------------------------------------

# Images and textures
*.png            filter=lfs diff=lfs merge=lfs -text
*.jpg            filter=lfs diff=lfs merge=lfs -text
*.jpeg           filter=lfs diff=lfs merge=lfs -text
*.gif            filter=lfs diff=lfs merge=lfs -text
*.bmp            filter=lfs diff=lfs merge=lfs -text
*.tga            filter=lfs diff=lfs merge=lfs -text
*.tif            filter=lfs diff=lfs merge=lfs -text
*.tiff           filter=lfs diff=lfs merge=lfs -text
*.psd            filter=lfs diff=lfs merge=lfs -text
*.exr            filter=lfs diff=lfs merge=lfs -text
*.hdr            filter=lfs diff=lfs merge=lfs -text
*.ico            filter=lfs diff=lfs merge=lfs -text
*.cubemap        filter=lfs diff=lfs merge=lfs -text

# Audio
*.mp3            filter=lfs diff=lfs merge=lfs -text
*.ogg            filter=lfs diff=lfs merge=lfs -text
*.wav            filter=lfs diff=lfs merge=lfs -text
*.aif            filter=lfs diff=lfs merge=lfs -text
*.aiff           filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4            filter=lfs diff=lfs merge=lfs -text
*.mov            filter=lfs diff=lfs merge=lfs -text
*.webm           filter=lfs diff=lfs merge=lfs -text

# 3D models
